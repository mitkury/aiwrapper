{
  "type": "module",
  "name": "aiwrapper",
  "description": "A Universal AI Wrapper for JavaScript & TypeScript",
  "version": "3.0.5",
  "author": "Dmitry Kury (https://dkury.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitkury/aiwrapper.git"
  },
  "bugs": {
    "url": "https://github.com/mitkury/aiwrapper/issues"
  },
  "homepage": "https://github.com/mitkury/aiwrapper#readme",
  "keywords": [
    "AI",
    "AI Wrappers",
    "AWS Bedrock",
    "OpenAI",
    "LLM",
    "Generative AI",
    "GPT",
    "GPT-4",
    "Anthropic",
    "Groq",
    "Mistral",
    "Llama",
    "Ollama",
    "DeepSeek"
  ],
  "files": [
    "dist/",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bedrock": {
      "types": "./dist/lang/bedrock/index.d.ts",
      "import": "./dist/lang/bedrock/index.js"
    },
    "./unstable/speech": {
      "types": "./dist/unstable/speech/index.d.ts",
      "import": "./dist/unstable/speech/index.js"
    },
    "./unstable/realtime": {
      "types": "./dist/unstable/realtime/index.d.ts",
      "import": "./dist/unstable/realtime/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc --project tsconfig.json",
    "check": "npm run build && npm run test:unit && npm run check:package",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "check:demo": "npm --prefix chat run check && npm --prefix chat run build",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:unit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "npm run build && vitest run integration --no-file-parallelism",
    "test:all": "npm test && npm run test:integration",
    "test:lang": "npm run build && vitest run tests/lang",
    "test:tools": "npm run build && vitest run tests/tools",
    "test:agents": "npm run build && vitest run tests/agents",
    "test:speech": "npm run build && vitest run tests/speech --no-file-parallelism",
    "test:img-in": "npm run build && vitest run tests/img-in",
    "test:img-out": "npm run build && vitest run tests/img-out",
    "test:model": "npm run build && vitest run tests/model.integration.test.ts",
    "aimodels:link": "./scripts/link-aimodels-local.sh",
    "aimodels:unlink": "./scripts/unlink-aimodels-local.sh",
    "aimodels:status": "./scripts/aimodels-status.sh"
  },
  "dependencies": {
    "aimodels": "^0.6.1",
    "ajv": "^8.17.1",
    "jsonic": "^2.16.0",
    "ws": "^8.21.3",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0",
    "@types/node": "^20.11.16",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  }
}
